# ── Frontend (TanStack Start / Vite) ─────────────────────────────────────────
# Public env vars must be prefixed with VITE_ to be exposed to the browser.
# VITE_API_URL=http://localhost:3001

# ── Backend (Express) ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=your_jwt_secret_here

# Database (optional — backend runs without one in demo mode)
# DATABASE_URL=postgres://user:password@localhost:5432/learnwise
