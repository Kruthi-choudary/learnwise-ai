# Server
PORT=3001
NODE_ENV=development

# CORS — set to your frontend dev URL (TanStack Start / Vite defaults to 8080)
CORS_ORIGIN=http://localhost:8080

# JWT secret — change before deploying
JWT_SECRET=your_jwt_secret_here

# Database (required) — a Supabase/Postgres connection string.
# Find yours in Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=postgres://user:password@localhost:5432/learnwise
